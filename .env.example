# Copie esse arquivo pra ".env" e ajuste o que precisar.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Porta local (o Railway ignora isso e injeta a dele própria via env var)
PORT=3000

# Máximo de pessoas por sala (mesh WebRTC não escala bem além disso)
MAX_ROOM_SIZE=8

# TURN server opcional — só necessário se algum amigo estiver atrás de NAT
# simétrico / wifi corporativo e a conexão P2P direta falhar mesmo com STUN.
# Deixe em branco pra usar só o STUN público padrão.
# Serviços prontos: Metered (metered.ca/tools/openrelay), Twilio, ou seu próprio coturn.
# TURN_URLS=turn:seu-turn-server.com:3478,turns:seu-turn-server.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
