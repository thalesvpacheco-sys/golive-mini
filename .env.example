# Copie esse arquivo pra ".env" e ajuste o que precisar.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Porta local (no Render e no docker compose ela é definida automaticamente)
PORT=3000

# Máximo de pessoas por sala
MAX_ROOM_SIZE=30

# LiveKit (áudio/vídeo/tela). Em cloud.livekit.io → Settings → API Keys.
# Pra testar local sem conta: rode `livekit-server --dev` e use
#   LIVEKIT_URL=ws://localhost:7880  LIVEKIT_API_KEY=devkey  LIVEKIT_API_SECRET=secret
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Deploy na VPS com docker compose (ver deploy/README.md) ----
# Subdomínio apontado pra VPS (o Caddy tira o HTTPS sozinho)
# DOMAIN=toca.usagi.com.br
