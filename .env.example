# Copie esse arquivo pra ".env" e ajuste o que precisar.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Porta local (no docker compose e no Render ela é definida automaticamente)
PORT=3000

# Máximo de pessoas por sala (mesh WebRTC não escala bem além disso)
MAX_ROOM_SIZE=8

# ---- Deploy na VPS com docker compose (ver deploy/README.md) ----
# Subdomínio apontado pra VPS (o Caddy tira o HTTPS sozinho)
# DOMAIN=live.seudominio.com.br
# Segredo compartilhado entre o app e o coturn. Gere com: openssl rand -hex 32
# TURN_SECRET=
# IP público da VPS. Na Oracle Cloud: IP_PUBLICO/IP_PRIVADO
# TURN_EXTERNAL_IP=

# ---- TURN fora do docker compose (rodando o app sozinho) ----
# Necessário só se alguém estiver atrás de NAT simétrico / wifi corporativo e
# a conexão P2P direta falhar mesmo com STUN. Em branco = só STUN público.
# TURN_URLS=turn:seu-turn-server.com:3478,turns:seu-turn-server.com:5349
# Com coturn em use-auth-secret, só o segredo (credenciais temporárias):
# TURN_SECRET=
# Ou usuário/senha fixos (serviços como Metered, Twilio):
# TURN_USERNAME=
# TURN_CREDENTIAL=
